# Node.js 24+ server with persistent private disk (VPS/container).
# SQLite is local and needs no external database account. Do NOT use this mode
# on Vercel/serverless ephemeral filesystems. Back up the private directory.
LEAD_STORAGE=sqlite
# Absolute path in a dedicated PRIVATE directory, outside site/public.
LEAD_DB_PATH=/workspace/Tolbuhina/.data/leads.sqlite
# Generate at least 32 random characters; server-only. Never paste in chat.
REGISTRATION_SECRET=
# Required before accepting personal data: real operator name and public contact.
SITE_OWNER_NAME=
SITE_OWNER_CONTACT=
# Required for npm run bot; optional for website-only mode. Never paste tokens in chat.
# TELEGRAM_CHAT_ID is the owner recipient; get your own numeric ID via /id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Full public HTTPS domain after publication (no invented URL).
SITE_URL=
# Optional alternative: set LEAD_STORAGE=supabase and configure these.
# SQLite variables are unused in Supabase mode. REGISTRATION_SECRET recommended;
# legacy deployments fall back to SUPABASE_SECRET_KEY for cookie signing.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional Vercel webhook to record bot Start. Random letters/digits, 32+ chars.
TELEGRAM_WEBHOOK_SECRET=
